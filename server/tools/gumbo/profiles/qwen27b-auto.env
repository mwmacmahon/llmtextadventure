# The 27B with the context sized to the free VRAM at load (llama-game.sh: CTX=auto -> llama.cpp --fit, leaving
# FIT_TARGET MiB free). Context checkpoints live in system RAM, not VRAM, so they do not count against it.
# The game reads the resulting slot size from /props.
MODEL=$HOME/llms/text-generation-webui/user_data/models/Huihui-Qwen3.5-27B-abliterated.i1-Q6_K.gguf
CTX=auto
CKPT=2048
