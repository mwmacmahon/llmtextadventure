# Qwen3.5-27B dense, abliterated (Huihui), i1-Q6_K, ~21 GB of weights. CKPT=2048 keeps the per-slot context
# checkpoints (about 100 MiB each on this model) from outgrowing the 5090; if it still does not fit, lower
# CTX to 65536 (about 21k a slot: the game reads the slot size from the server and trims the narrator's
# window to it). See docs/LOCAL_LLM.md "The next model".
MODEL=$HOME/llms/text-generation-webui/user_data/models/Huihui-Qwen3.5-27B-abliterated.i1-Q6_K.gguf
CTX=98304
CKPT=2048
