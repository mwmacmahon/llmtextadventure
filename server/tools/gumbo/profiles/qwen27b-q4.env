# The 27B at i1-Q4_K_M (16.5 GB of weights against Q6_K's 22.1): fewer bytes to read per token, so faster decoding
# (the 5090 is memory-bound at batch 1), at some cost in quality to be measured on the graded key. Same context
# and checkpoints as `qwen27b`.
MODEL=$HOME/llms/text-generation-webui/user_data/models/Huihui-Qwen3.5-27B-abliterated.i1-Q4_K_M.gguf
CTX=98304
CKPT=2048
